{
  "expo": {
    "name": "NovaNews",
    "slug": "nova-news",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "novanews",
    "userInterfaceStyle": "automatic",
    "platforms": [
      "ios",
      "android",
      "web"
    ],
    "sdkVersion": "54.0.0",
    "extra": {
      "eas": {
        "projectId": "fd24a00c-1d32-48da-b014-2ada8fa65cd5"
      },
      "apiUrl": "https://nova-news.onrender.com/api"
    },
    "ios": {
      "bundleIdentifier": "com.michelle.novanews",
      "buildNumber": "1.0.17",
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "Allow taking a profile photo.",
        "NSPhotoLibraryUsageDescription": "Allow selecting a photo for your profile.",
        "NSLocationWhenInUseUsageDescription": "Show nearby resources using your location.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "updates": {
      "enabled": false
    },
    "android": {
      "package": "com.michelle.novanews",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#FFFFFF"
      },
      "edgeToEdgeEnabled": true
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-asset",
      "expo-font",
      "expo-secure-store"
    ]
  }
}
