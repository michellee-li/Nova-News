{
  "extends": "node_modules/expo/tsconfig.base",
  "compilerOptions": {
    "jsx": "react-jsx",
    "strict": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "moduleResolution": "bundler",
    "module": "ESNext",
    "target": "ESNext",
    "customConditions": ["react-native"],
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "baseUrl": ".",  
    "paths": {
      "@/*": [
        "./*"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    "types",
    "src"
  ]
}
